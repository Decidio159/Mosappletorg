# =========================================================
# Эталонная конфигурация Apache (Beget) — закрывает пункты
# 8.2–8.4 тех-листа. Класть в корень сайта клиента.
# =========================================================

# --- https и адрес без www ---
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# --- /index.html → / ---
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# --- красивые адреса без .html ---
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# --- защитные заголовки ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS включать только когда https уже точно работает
  # Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

# --- запрет листинга папок ---
Options -Indexes

# --- своя страница 404 ---
ErrorDocument 404 /404.html

# --- кэш статики ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- сжатие ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- служебное наружу не отдаём ---
<FilesMatch "\.(bak|md|log|sql|zip)$">
  Require all denied
</FilesMatch>
